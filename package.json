{
  "name": "turnamen-match-updater",
  "version": "1.1.0",
  "description": "Desktop Match Scorer & Videotron Scoreboard",
  "author": "Muhammad Rusyaid <admin@turnamen.info>",
  "homepage": "https://turnamen.info",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "info.turnamen.scorer",
    "productName": "TurnamenScorer",
    "files": [
      "main.js",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Sports"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
